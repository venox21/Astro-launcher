<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Uninstall ASTRO Launcher</AssemblyName>
    <RootNamespace>AstroUninstaller</RootNamespace>
    <ApplicationIcon>..\..\assets\astro.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version Condition="'$(AstroVersion)' != ''">$(AstroVersion)</Version>
    <Version Condition="'$(AstroVersion)' == ''">1.0.0</Version>
    <Product>ASTRO Launcher</Product>
    <Company>ASTRO</Company>
    <Authors>ASTRO</Authors>
    <Copyright>Copyright © 2026 ASTRO</Copyright>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Common\*.cs" LinkBase="Common" />
    <EmbeddedResource Include="..\..\assets\astro-logo-256.png" LogicalName="AstroUninstaller.astro-logo-256.png" />
  </ItemGroup>
</Project>
