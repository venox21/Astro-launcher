<Window x:Class="AstroUninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASTRO Launcher Deinstallation"
        Width="490"
        Height="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#121E27" />
            <Setter Property="Foreground" Value="#C7D0D4" />
            <Setter Property="BorderBrush" Value="#2A3E4C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#192A37" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4800D9FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#041016" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00E0FF" Offset="0" />
                                    <GradientStop Color="#0095FF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#4A00E0FF">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF081219" Offset="0" />
                <GradientStop Color="#FF03080C" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity="0.72" />
        </Border.Effect>

        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0"
                            BorderBrush="#4000D9FF" BorderThickness="1">
                        <Image x:Name="LogoImage" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ASTRO" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" />
                            <TextBlock Text=" LAUNCHER" FontSize="17" FontWeight="Black" Foreground="#00D9FF" />
                        </StackPanel>
                        <TextBlock Text="Deinstallations-Assistent" FontSize="11.5" Foreground="#7A94A3" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="CloseButton"
                        Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="26"
                        Height="26"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#7A94A3"
                        FontSize="13"
                        Cursor="Hand"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,6">
                <TextBlock x:Name="TitleText"
                           Text="ASTRO Launcher deinstallieren?"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#EEF7FA" />
                <TextBlock x:Name="MessageText"
                           Text="Alle Programmdateien und Verknüpfungen werden sauber von diesem PC entfernt."
                           FontSize="12.5"
                           Foreground="#A6BAC6"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
                <TextBlock x:Name="PathText"
                           FontSize="11"
                           Foreground="#5D7787"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,8,0,0" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="CancelButton"
                        Content="Abbrechen"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="CloseButton_Click" />
                <Button x:Name="UninstallButton"
                        Content="Deinstallieren"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="UninstallButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
