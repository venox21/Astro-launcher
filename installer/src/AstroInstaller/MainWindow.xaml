<Window x:Class="AstroInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASTRO Launcher Setup"
        Width="496"
        Height="224"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="AstroProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="9" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#0D1A23"
                                BorderBrush="#2400D9FF"
                                BorderThickness="1"
                                CornerRadius="4.5"
                                ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00E5FF" Offset="0" />
                                            <GradientStop Color="#007BFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00D9FF" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#12212C" />
            <Setter Property="Foreground" Value="#D8E6EE" />
            <Setter Property="BorderBrush" Value="#3500D9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#192E3D" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8000D9FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#4A00E0FF">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF081219" Offset="0" />
                <GradientStop Color="#FF03080C" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity="0.72" />
        </Border.Effect>

        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0"
                            BorderBrush="#4000D9FF" BorderThickness="1">
                        <Image x:Name="LogoImage" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ASTRO" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" />
                            <TextBlock Text=" LAUNCHER" FontSize="18" FontWeight="Black" Foreground="#00D9FF" />
                            <Border Background="#1600D9FF" BorderBrush="#4000D9FF" BorderThickness="1"
                                    CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionBadgeText" Text="v1.0.0" FontSize="10.5"
                                           FontWeight="SemiBold" Foreground="#7FEFFF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="1-Klick Express-Installation" FontSize="11.5" Foreground="#7A94A3" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="CloseButton"
                        Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="26"
                        Height="26"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#7A94A3"
                        FontSize="13"
                        Cursor="Hand"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- Progress Body -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,4">
                <Grid Margin="0,0,0,10">
                    <TextBlock x:Name="StatusText"
                               Text="Vorbereitung …"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#EEF7FA"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="PercentText"
                               Text="0%"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="#00D9FF"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <ProgressBar x:Name="InstallProgressBar" Style="{StaticResource AstroProgressBarStyle}" Value="0" />

                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailText"
                               Grid.Column="0"
                               Text="Initialisiere Setup …"
                               FontSize="11.5"
                               Foreground="#6F8A9A"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />
                    <TextBlock x:Name="SizeText"
                               Grid.Column="1"
                               Text=""
                               FontSize="11.5"
                               Foreground="#8CA7B8" />
                </Grid>
            </StackPanel>

            <!-- Error Fallback Panel -->
            <StackPanel x:Name="ErrorPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Installation fehlgeschlagen" FontSize="14.5" FontWeight="Bold" Foreground="#FF6B7F" />
                <TextBlock x:Name="ErrorMessageText"
                           FontSize="12"
                           Foreground="#B8C7D0"
                           TextWrapping="Wrap"
                           MaxHeight="52"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Schließen" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="CloseButton_Click" />
                    <Button Content="Erneut versuchen" Style="{StaticResource ActionButtonStyle}" Click="RetryButton_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <TextBlock x:Name="FooterHintText"
                       Grid.Row="2"
                       Text="Installiert automatisch in AppData und startet den Launcher."
                       FontSize="11"
                       Foreground="#4D6878" />
        </Grid>
    </Border>
</Window>
